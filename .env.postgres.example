# Copy to .env, then replace all values before production use.
# This file is intentionally safe to commit only as an example.
POSTGRES_IMAGE=postgres:17@sha256:a426e44bac0b759c95894d68e1a0ac03ecc20b619f498a91aae373bf06d8508d
POSTGRES_DB=sosopo
POSTGRES_USER=sosopo
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://sosopo:replace-with-a-long-random-password@postgres:5432/sosopo

# Required for encrypted multi-account provider credentials.
# Generate once with:
# docker compose -f compose.yaml -f compose.postgres.yaml run --rm sosopo python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOSOPO_ENCRYPTION_KEY=
