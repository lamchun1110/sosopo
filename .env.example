# Copy to .env, fill only the providers you want, then restart with:
# docker compose up -d --build
# Never commit .env.
# Generate once with: docker compose run --rm sosopo python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOSOPO_ENCRYPTION_KEY=
# Or mount a Docker/Kubernetes secret and use: SOSOPO_ENCRYPTION_KEY_FILE=/run/secrets/sosopo_encryption_key
SOSOPO_PUBLIC_URL=https://sosopo.example.com

# Uploaded media storage. Local disk is the default. For S3/MinIO, set a public
# HTTPS CDN/bucket URL that providers can fetch from.
SOSOPO_STORAGE_BACKEND=local
# S3_MEDIA_BUCKET=sosopo-media
# S3_MEDIA_PREFIX=uploads
# SOSOPO_MEDIA_PUBLIC_URL=https://media.sosopo.example.com
# AWS_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
# AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key

# Optional OpenID Connect SSO. Choose one issuer:
# Google Workspace: https://accounts.google.com
# Microsoft Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# Active Directory Federation Services: https://adfs.example.com/adfs
# The redirect URI is: https://sosopo.example.com/api/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOW_SIGNUP=false

# Retain administrator audit metadata for this many days (minimum 1).
SOSOPO_AUDIT_RETENTION_DAYS=365
# Optional: only trust X-Forwarded-For from these direct proxy CIDRs.
# SOSOPO_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Production recommendation: PostgreSQL. Backups include the database and uploads.
# Run with: docker compose run --rm sosopo python /app/scripts/backup.py
# BACKUP_DESTINATION=local # or s3
# BACKUP_LOCAL_DIR=/backups
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=sosopo-backups
# S3_SERVER_SIDE_ENCRYPTION=AES256
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BACKUP_DESTINATION=local
BACKUP_LOCAL_DIR=/backups
BACKUP_INTERVAL_SECONDS=86400
S3_PREFIX=sosopo

# Optional external database. Leave blank to use /data/sosopo.sqlite3.
# DATABASE_URL=postgresql://sosopo:change-me@postgres:5432/sosopo
# DATABASE_URL=mysql://sosopo:change-me@mariadb:3306/sosopo
DATABASE_URL=
# DATABASE_URL_FILE=/run/secrets/sosopo_database_url

# Public HTTPS address that Meta can fetch uploaded images from.
SOSOPO_PUBLIC_BASE_URL=https://sosopo.example.com

# Optional private Prometheus endpoint. When set, /metrics requires
# Authorization: Bearer <this value>. Never expose it through a public proxy.
SOSOPO_METRICS_TOKEN=

# Meta Graph API (Facebook Page and Instagram)
META_GRAPH_BASE_URL=https://graph.facebook.com/v24.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional OAuth connection flow. Register ${SOSOPO_PUBLIC_URL}/api/social-oauth/callback
# as the exact redirect URI in your Meta app.
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Threads API
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_OAUTH_CLIENT_ID=
THREADS_OAUTH_CLIENT_SECRET=

# X API: user access token with post.write permission
X_ACCESS_TOKEN=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Discord: create an incoming webhook for each target channel. Prefer connecting
# it through the dashboard OAuth flow, which lets users select a channel.
DISCORD_WEBHOOK_URL=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# LinkedIn: member OAuth uses w_member_social. For organization posting, use an
# approved organization author URN and a token with w_organization_social.
LINKEDIN_AUTHOR_URN=urn:li:person:your_member_id
LINKEDIN_ACCESS_TOKEN=
# Required by LinkedIn's versioned REST API; update after reviewing its changelog.
LINKEDIN_API_VERSION=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# Telegram: bot must be an administrator in the target channel/group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel

# Optional AI writing assistant. Configure one or more OpenAI-compatible
# providers; only fully configured providers appear in the composer.
# OpenAI and OpenRouter have built-in API bases. Kimi, MiniMax, and Z.AI GLM
# require the current OpenAI-compatible HTTPS base from the vendor dashboard.
SOSOPO_AI_OPENAI_API_KEY=
SOSOPO_AI_OPENAI_MODEL=
SOSOPO_AI_OPENROUTER_API_KEY=
SOSOPO_AI_OPENROUTER_MODEL=
SOSOPO_AI_KIMI_API_KEY=
SOSOPO_AI_KIMI_BASE_URL=
SOSOPO_AI_KIMI_MODEL=
SOSOPO_AI_MINIMAX_API_KEY=
SOSOPO_AI_MINIMAX_BASE_URL=
SOSOPO_AI_MINIMAX_MODEL=
SOSOPO_AI_ZAI_API_KEY=
SOSOPO_AI_ZAI_BASE_URL=
SOSOPO_AI_ZAI_MODEL=
